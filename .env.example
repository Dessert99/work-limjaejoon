# 미다운로드 결과는 합의한 10분 뒤 삭제하며 중단된 업로드에도 같은 기간을 적용한다.
RESULT_TTL_SECONDS=600
# 요청 상한은 PRD 초안의 초기 운영값이며 실제 사용 측정 후 조정한다.
PDF_RATE_LIMIT=20
DOCUMENT_RATE_LIMIT=10
# H2Orestart가 설치된 컨테이너에서 HWP·HWPX 실험 변환을 허용한다.
HWP_EXPERIMENTAL_ENABLED=1
# 맥미니에서는 https://work.limjaejoon.com으로 바꾸고 개발 PC에서는 기본값을 유지한다.
FRONTEND_ORIGIN=http://localhost:3100
